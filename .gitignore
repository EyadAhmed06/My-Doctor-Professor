node_modules/
**/node_modules/

# Environment files stay local; examples remain versioned.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Local database trust bundle and managed state.
backend/global-bundle.pem
backend/uploads/
backend/backups/

# Build and test artifacts.
frontend/.next/
backend/dist/
coverage/
**/coverage/
frontend/test-results/
frontend/playwright-report/
.idea/
.vscode/
*.log
*.tsbuildinfo

# Terraform local state, cached providers, plans, and environment overrides.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
**/terraform.tfvars
crash.log

# 3D anatomy assets. Generated by scripts/anatomy/prepare-model.mjs from CC BY-SA sources.
# Kept out of git deliberately: this repo does not need hundreds of megabytes of meshes in
# its history. Regenerate with `npm --prefix scripts run anatomy:prepare -- --in <src.glb> --region <name>`.
frontend/public/anatomy/*.glb
frontend/public/anatomy/*.png
