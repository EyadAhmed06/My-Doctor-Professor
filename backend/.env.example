# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_doctor_professor
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Required when DB_SSL_ENABLED=true and certificate verification is enabled.
DB_SSL_CA_PATH=./global-bundle.pem

# One-time account bootstrap
# Enable only until the first SYSTEM_ADMIN, INSTRUCTOR and STUDENT are created.
# The endpoint permanently closes as soon as any system administrator exists.
ALLOW_ACCOUNT_BOOTSTRAP=false
ACCOUNT_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Refresh cookie path (defaults to /api/v1/auth if unset).
# In local development (unproxied directly on port 3000), set to /auth.
# In production, leave unset or set to /api/v1/auth to match reverse-proxy routing.
AUTH_COOKIE_PATH=/api/v1/auth

# Google Identity Services
# Optional. Leave blank to disable Google sign-in; the frontend reads this at runtime from /auth/google/config.
GOOGLE_CLIENT_ID=
GOOGLE_ONBOARDING_TTL_SECONDS=600

# Reverse proxy
TRUST_PROXY_HOPS=0

# CORS and account-action origins
FRONTEND_URL=http://localhost:3001
# Optional comma-separated additional trusted frontend origins; use HTTPS in production.
CORS_ORIGINS=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@mydoctorprofessor.com
# Six-digit account verification and password reset codes expire after 10 minutes.
EMAIL_VERIFICATION_TTL_SECONDS=600
PASSWORD_RESET_OTP_TTL_SECONDS=600
# Short-lived reset session issued only after a correct OTP. The service caps it at 15 minutes.
PASSWORD_RESET_TTL_SECONDS=900
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Managed file uploads
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800
# Profile pictures are JPEG/PNG/WebP only. Hard maximum accepted configuration is 10 MiB.
PROFILE_PICTURE_MAX_BYTES=5242880

# PDF inspection performance
# Keep OCR worker count bounded to avoid CPU oversubscription on small instances.
PDF_OCR_CONCURRENCY=2
PDF_OCR_THREADS_PER_WORKER=1
PDF_OCR_RENDER_BATCH_SIZE=8

# Question PDF AI enrichment via OpenRouter
# The source PDF/instructor answer key remains authoritative. AI only explains and flags inconsistencies.
# Never commit a real API key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta/muse-spark-1.3
# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=My Doctor Professor

# Legacy OpenAI PDF-recovery settings are retained only for older recovery code paths.
OPENAI_API_KEY=
OPENAI_QUESTION_ENRICHMENT_MODEL=gpt-5-mini

# Backup snapshots. backup:create stores a pg_dump plus managed uploads and manifest checksums.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Restore is intentionally blocked unless RESTORE_MODE=replace is supplied at execution time.
# Production additionally requires CONFIRM_PRODUCTION_RESTORE=I_UNDERSTAND_THIS_REPLACES_DATA.

# Logging
LOG_LEVEL=debug
