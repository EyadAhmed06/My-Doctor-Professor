# Application
PORT=3000
NODE_ENV=development

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_doctor_professor
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_doctor_professor

# JWT Configuration
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# CORS
FRONTEND_URL=http://localhost:3001
API_URL=http://localhost:3000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@mydoctorprofessor.com
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
# Generate with: openssl rand -base64 32
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# File Upload
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# Logging
LOG_LEVEL=debug

