# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_doctor_professor
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Required when DB_SSL_ENABLED=true and certificate verification is enabled.
DB_SSL_CA_PATH=./global-bundle.pem

# One-time account bootstrap
# Enable only until the first SYSTEM_ADMIN, INSTRUCTOR and STUDENT are created.
# The endpoint permanently closes as soon as any system administrator exists.
ALLOW_ACCOUNT_BOOTSTRAP=false
ACCOUNT_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Google Identity Services
# Use the same Web application client ID in the frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com
GOOGLE_ONBOARDING_TTL_SECONDS=600

# Reverse proxy
TRUST_PROXY_HOPS=0

# CORS and generated account-action links
FRONTEND_URL=http://localhost:3001

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@mydoctorprofessor.com
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Managed file uploads
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# Question PDF AI enrichment
# Required for automatic 4-7 line MCQ explanations and estimated difficulty during PDF inspection.
# Never commit a real API key.
OPENAI_API_KEY=
# Optional; defaults to gpt-5-mini.
OPENAI_QUESTION_ENRICHMENT_MODEL=gpt-5-mini

# Backup snapshots. backup:create stores a pg_dump plus managed uploads and manifest checksums.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Restore is intentionally blocked unless RESTORE_MODE=replace is supplied at execution time.
# Production additionally requires CONFIRM_PRODUCTION_RESTORE=I_UNDERSTAND_THIS_REPLACES_DATA.

# Logging
LOG_LEVEL=debug
