# Save the completed contents as the GitHub Actions secret PRODUCTION_ENV_FILE.
# Never commit the completed file.
DB_NAME=my_doctor_professor
DB_USERNAME=mdp_app
DB_PASSWORD=GENERATE_A_LONG_RANDOM_DATABASE_PASSWORD

JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

FRONTEND_URL=https://REPLACE_WITH_TERRAFORM_APPLICATION_HOST
CORS_ORIGINS=
ALLOW_ACCOUNT_BOOTSTRAP=false

# Optional. Leave blank to deploy with Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_ONBOARDING_TTL_SECONDS=600

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Use the authenticated mailbox or a sender identity/alias verified by the provider.
SMTP_FROM=My Doctor & The Professor <YOUR_VERIFIED_SENDER@example.com>
# Six-digit account verification and password reset codes expire after 10 minutes.
EMAIL_VERIFICATION_TTL_SECONDS=600
PASSWORD_RESET_OTP_TTL_SECONDS=600
# Short-lived reset session issued only after a correct OTP. The service caps it at 15 minutes.
PASSWORD_RESET_TTL_SECONDS=900
EMAIL_OUTBOX_ENCRYPTION_KEY=GENERATE_A_BASE64_ENCODED_32_BYTE_KEY

MAX_FILE_SIZE=52428800
OPENAI_API_KEY=
OPENAI_QUESTION_ENRICHMENT_MODEL=gpt-5-mini
LOG_LEVEL=info
