# NestJS API (Nest runs on 3000; the Next.js development server runs on 3001).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Identity Services Web application client ID.
# Must match backend GOOGLE_CLIENT_ID and include http://localhost:3001 as an authorized JavaScript origin for local development.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com
